  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Full administrative access"
      },
      {
        "name": "dispatcher",
        "description": "Dispatcher access for management console"
      },
      {
        "name": "driver",
        "description": "Driver role for the mobile app"
      },
      {
        "name": "customer",
        "description": "Customer role for the mobile app"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma-authorization}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "default-roles-driveops-dev",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "customer"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        },
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "driveops-backend",
      "name": "DriveOps Backend API",
      "description": "Backend API service client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${DRIVEOPS_BACKEND_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
    "fullScopeAllowed": true,
    "defaultClientScopes": [
      "web-origins",
      "profile",
      "roles",
      "email",
      "basic"
    ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "driveops-desktop",
      "name": "DriveOps Desktop App",
      "description": "Flutter desktop management app (PKCE flow)",
      "enabled": true,
      "rootUrl": "http://127.0.0.1:42069",
      "redirectUris": [
        "http://127.0.0.1:42069/auth/callback",
        "http://localhost:42069/auth/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:42069",
        "http://localhost:42069"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "publicClient": true,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "attributes": {
        "post.logout.redirect.uris": "http://127.0.0.1:42069##http://localhost:42069",
        "pkce.code.challenge.method": "S256"
      },
    "fullScopeAllowed": true,
    "defaultClientScopes": [
      "web-origins",
      "profile",
      "roles",
      "email",
      "basic"
    ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "driveops-mobile",
      "name": "DriveOps Mobile App",
      "description": "Flutter mobile app for drivers and customers (PKCE flow)",
      "enabled": true,
      "redirectUris": [
        "com.driveops.mobile://oauth2redirect"
      ],
      "webOrigins": [],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "publicClient": true,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "attributes": {
        "post.logout.redirect.uris": "com.driveops.mobile://logout",
        "pkce.code.challenge.method": "S256"
      },
    "fullScopeAllowed": true,
    "defaultClientScopes": [
      "web-origins",
      "profile",
      "roles",
      "email",
      "basic"
    ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ]
}