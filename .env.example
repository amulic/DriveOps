# DriveOps environment template.
#
# Copy this file to DriveOpsAPI/.env and fill in real values (or extract the real
# .env from .env-tajne.zip, password "fit"). NEVER commit the real .env — it is
# gitignored; only this template is tracked.
#
# The same file is used by:
#   * docker compose (automatic ${VAR} interpolation + env_file injection)
#   * both .NET services for `dotnet run` (DotEnvLoader walks up to find it)
#     - the DRIVEOPS_*_CONNECTION values are mapped to ConnectionStrings:DefaultConnection
#     - Keycloak__*/RabbitMQ__* override the blanked appsettings entries
#
# After rotating any value, re-create the stack with:
#   docker compose down -v && docker compose up -d --build
# (Keycloak imports the realm only on a fresh volume.)

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
KC_DB_PASSWORD=change-me-keycloak-db
DRIVEOPS_API_DB_PASSWORD=change-me-api-db
DRIVEOPS_REALTIME_DB_PASSWORD=change-me-realtime-db

# --- Keycloak ---
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-keycloak-admin
DRIVEOPS_BACKEND_CLIENT_SECRET=change-me-backend-client-secret

# --- Keycloak seed users (consumed by realm JSON ${...} placeholders) ---
SEED_PASSWORD_ADMIN=change-me
SEED_PASSWORD_DISPATCHER=change-me
SEED_PASSWORD_TESTUSER=change-me
SEED_PASSWORD_MARCUSJOHNSON=change-me
SEED_PASSWORD_SARAHWILLIAMS=change-me
SEED_PASSWORD_DAVIDCHEN=change-me
SEED_PASSWORD_EMILYRODRIGUEZ=change-me
SEED_PASSWORD_JAMESBROWN=change-me
SEED_PASSWORD_JOHNDOE=change-me
SEED_PASSWORD_JANESMITH=change-me
SEED_PASSWORD_BOBWILSON=change-me

# --- RabbitMQ ---
RABBITMQ_PASSWORD=change-me-rabbitmq

# --- .NET services (dotnet run; compose injects its own service-specific values) ---
DRIVEOPS_API_CONNECTION=Server=localhost;Port=3306;Database=driveops_api;User=driveops_api;Password=change-me-api-db;
DRIVEOPS_REALTIME_CONNECTION=Server=localhost;Port=3306;Database=driveops_realtime;User=driveops_realtime;Password=change-me-realtime-db;
Keycloak__AdminClientSecret=change-me-backend-client-secret
RabbitMQ__Password=change-me-rabbitmq

# --- Stripe (optional for the compose flow; `dotnet run` uses .NET user-secrets) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
